# Keep project Markdown documentation local and out of commits.
**/*.md
**/*.MD
.opencode/debug.port
.opencode/debug.log

# Local dev logs.
*.log

# Never commit real environment files. Nested .gitignore files also cover these;
# this is defence in depth for any .env added at the repo root.
.env
.env.*
!.env.example

# Access-key transfer files (never commit)
keys.env
keys*.env
*.keys.env

# Google service-account keys (never commit)
ga4-key.json
*.ga4.json
GA4_*.json
service-account*.json
