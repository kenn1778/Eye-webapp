// EYE backend data model.
// Prisma 7: the connection URL is configured in prisma.config.ts (the `url`
// field was removed from the datasource block). The generated client is emitted
// as plain JS so the ESM Node backend can import it without a TypeScript build.

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())

  stories      Story[]
  posts        Post[]
  communities  Community[]
  chatMessages ChatMessage[]
  reviews      Review[]
}

model Story {
  id          String    @id @default(cuid())
  title       String
  content     String
  authorId    String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  author User? @relation(fields: [authorId], references: [id])
}

model Post {
  id          String    @id @default(cuid())
  title       String
  content     String
  excerpt     String    @default("")
  category    String    @default("Scholarships")
  image       String    @default("")
  actionUrl   String?
  actionLabel String?
  // draft | published | scheduled
  status      String    @default("draft")
  publishedAt DateTime?
  deletedAt   DateTime?
  authorId    String?
  mediaAssetId String?
  linkHeaderAssetId String?
  audioAssetId String?
  videoAssetId String?
  linkHeaderUrl String?
  audioUrl String?
  videoUrl String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  author User? @relation(fields: [authorId], references: [id])
  mediaAsset MediaAsset? @relation("PostFeaturedMedia", fields: [mediaAssetId], references: [id], onDelete: SetNull)
  linkHeaderAsset MediaAsset? @relation("PostLinkHeaderMedia", fields: [linkHeaderAssetId], references: [id], onDelete: SetNull)
  audioAsset MediaAsset? @relation("PostAudioMedia", fields: [audioAssetId], references: [id], onDelete: SetNull)
  videoAsset MediaAsset? @relation("PostVideoMedia", fields: [videoAssetId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
  @@index([deletedAt, createdAt])
  @@index([mediaAssetId])
  @@index([linkHeaderAssetId])
  @@index([audioAssetId])
  @@index([videoAssetId])
}

model Community {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  ownerId     String?
  createdAt   DateTime @default(now())

  owner        User?         @relation(fields: [ownerId], references: [id])
  chatMessages ChatMessage[]
  memberships  CommunityMembership[]
}

model CommunityMembership {
  id          String   @id @default(cuid())
  visitorId   String
  communityId String
  createdAt   DateTime @default(now())

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([visitorId, communityId])
  @@index([communityId, createdAt])
}

model ChatMessage {
  id          String   @id @default(cuid())
  content     String
  authorId    String?
  communityId String?
  createdAt   DateTime @default(now())

  author    User?      @relation(fields: [authorId], references: [id])
  community Community? @relation(fields: [communityId], references: [id])

  // Supports the admin activity time-series (bucketed by day).
  @@index([createdAt])
}

model Review {
  id        String   @id @default(cuid())
  name      String   @default("Reader")
  rating    Int
  comment   String?
  published Boolean  @default(true)
  authorId  String?
  createdAt DateTime @default(now())

  author User? @relation(fields: [authorId], references: [id])

  @@index([published, createdAt])
}

// Single-admin profile overlay supports persistent profile/password updates
// even when the initial administrator is configured through environment vars.
model AdminProfile {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String   @default("Administrator")
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Persistent team access entries. Invitations are tracked as pending because
// this deployment has no mail provider or multi-user authentication flow yet.
model Moderator {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      String   @default("Moderator")
  status    String   @default("Invited")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

// Binary data lives in a private S3 bucket; only object metadata is kept in
// Postgres so references remain available to every API instance/browser.
model MediaAsset {
  id           String   @id @default(cuid())
  objectKey    String   @unique
  originalName String
  mimeType     String
  sizeBytes    BigInt
  status       String   @default("pending")
  altText      String?
  uploadedBy   String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  featuredPosts Post[] @relation("PostFeaturedMedia")
  linkHeaderPosts Post[] @relation("PostLinkHeaderMedia")
  audioPosts Post[] @relation("PostAudioMedia")
  videoPosts Post[] @relation("PostVideoMedia")

  @@index([status, createdAt])
  @@index([uploadedBy, createdAt])
}

model NewsletterSubscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  subscribedAt DateTime @default(now())
  confirmed    Boolean  @default(false)

  // Supports the admin activity time-series (bucketed by day).
  @@index([subscribedAt])
}

// Single-use links for the password reset flow. Only the SHA-256 hash of the
// token is stored, so a leaked row cannot be replayed against the API.
model PasswordResetToken {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, expiresAt])
}

// Admin-facing feed. Rows are created by domain events (a new subscriber, a new
// community message) and read/dismissed state is persisted per row so the
// dashboard can show an accurate unread count across sessions.
model Notification {
  id        String   @id @default(cuid())
  // "subscriber" | "chat" | "system"
  type      String
  title     String
  body      String?
  // Non-sensitive display label for the actor (e.g. a masked email or name).
  actor     String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  // The dashboard always filters by read state and orders by recency.
  @@index([read, createdAt])
}

// Premium membership. Members are identified by email (the public site has no
// member accounts yet): a row is created when checkout starts and flipped to
// "active" once Paystack confirms payment.
model Subscription {
  id               String    @id @default(cuid())
  email            String    @unique
  plan             String    @default("premium")
  // pending | active | cancelled | expired
  status           String    @default("pending")
  provider         String    @default("paystack")
  providerRef      String?   @unique
  currentPeriodEnd DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // The dashboard and access checks filter by status and expiry.
  @@index([status, currentPeriodEnd])
}

// Audit log for every admin action. Records who did what, when, and on which
// resource so the dashboard can show a full activity trail.
model AuditLog {
  id         String   @id @default(cuid())
  // Admin user id (null if session predates user linking).
  actorId    String?
  actorEmail String
  // HTTP method: "POST" | "PATCH" | "DELETE" | "GET"
  method     String
  // Route path, e.g. "/posts", "/moderators/:id"
  path       String
  // Resource type affected: "post" | "moderator" | "community" | "profile" | "notification"
  resource   String
  // Resource id if applicable.
  resourceId String?
  // Short human-readable description of the action.
  action     String
  // HTTP response outcome for the attempted action.
  statusCode Int
  success    Boolean  @default(true)
  // Safe request metadata only (for example, changed field names).
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([actorEmail, createdAt])
  @@index([resource, createdAt])
  @@index([createdAt])
}
