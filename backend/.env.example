# EYE backend configuration. Copy this file to .env and fill in real values.
PORT=4000
NODE_ENV=development

# Admin account. Generate the hash with: npm run hash-password
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=

# Random 48+ character secret used to sign session cookies.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_JWT_SECRET=

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Session lifetime in hours.
SESSION_TTL_HOURS=8

# Set true when running behind a reverse proxy/CDN so secure cookies work.
TRUST_PROXY=false

# Force the Secure cookie flag. Keep true in production (HTTPS only).
COOKIE_SECURE=false

# Postgres connection string used by Prisma (also read by prisma.config.ts).
# Managed Postgres (e.g. RDS) forces TLS with a self-signed cert, so append
# sslmode=no-verify there. Local Postgres needs no sslmode.
DATABASE_URL=postgresql://user:password@localhost:5432/eye?schema=public

# AWS S3. Use an EC2/Lightsail/ECS IAM role with least-privilege access;
# do not place long-lived AWS access keys here.
AWS_REGION=us-east-1
S3_MEDIA_BUCKET=
# Optional public API origin (empty means same-origin /api/v1/public/media/:id).
S3_MEDIA_PUBLIC_BASE_URL=
# Separate, private bucket for compressed pg_dump backups.
S3_BACKUP_BUCKET=
S3_BACKUP_PREFIX=postgres
# Optional KMS key ARN/ID for backup objects; empty uses S3 AES256 encryption.
S3_BACKUP_SSE_KMS_KEY_ID=
# Optional endpoint/path style for S3-compatible development services.
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_UPLOAD_URL_TTL_SECONDS=600

# Log level for the pino logger (trace|debug|info|warn|error|fatal).
LOG_LEVEL=debug

# Optional Redis connection used for caching and the rate-limit store.
# Leave empty to use the built-in in-memory fallbacks (single-process only).
REDIS_URL=

# Google Gemini API key for the community chat assistant.
# Get one at https://aistudio.google.com/apikey. Leave empty to disable the
# assistant (the chat then uses its built-in fallback replies).
GEMINI_API_KEY=

# Gemini model used for chat replies. "gemini-flash-latest" tracks the current
# stable Flash model; override if your key lacks access.
GEMINI_MODEL=gemini-flash-latest

# Abort a Gemini request after this many milliseconds.
GEMINI_TIMEOUT_MS=12000

# --- Premium membership (Paystack) ---
# Leave PAYSTACK_SECRET_KEY empty to disable checkout entirely.
# Get keys at https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Currency and monthly price (in the smallest unit: kobo for NGN).
MEMBERSHIP_CURRENCY=NGN
MEMBERSHIP_PRICE_KOBO=250000

# Where Paystack returns the browser after payment (your pricing page).
MEMBERSHIP_CALLBACK_URL=
