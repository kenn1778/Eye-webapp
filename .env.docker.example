DATABASE_URL=postgresql://postgres:postgres@db:5432/scholarship
REDIS_URL=redis://redis:6379
AUTH_JWT_SECRET=change-me-64-char-secret-generate-with-crypto-randomBytes-48
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=change-me-bcrypt-hash
PORT=4000
CORS_ORIGIN=http://localhost:8080
SESSION_TTL_HOURS=8
TRUST_PROXY=true
COOKIE_SECURE=false
LOG_LEVEL=info

# Transactional email (Resend). Leave RESEND_API_KEY empty to disable sending;
# queued emails are then logged instead of delivered.
RESEND_API_KEY=
EMAIL_FROM="EYE Scholarships <hello@example.com>"
# Public API origin used for links in emails (confirmation, password reset).
PUBLIC_API_URL=http://localhost:4000
# Public web-app origin used for the password-reset link that goes in emails.
APP_BASE_URL=http://localhost:8080
