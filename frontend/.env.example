# Gate the admin workspace. Set to "true" to enable /admin routes.
VITE_ENABLE_ADMIN=false

# Backend API base URL. Leave empty in development to use the Vite proxy.
# In production set this to the API origin, e.g. https://api.example.com
VITE_API_BASE_URL=

# Admin credentials are NOT stored in the client bundle any more.
# The server verifies credentials and issues an HttpOnly session cookie.
# See backend/.env.example to configure the admin account.

# --- Monetization (all optional; leave blank to disable) ---

# Google AdSense publisher id, e.g. ca-pub-1234567890123456.
# When set, ad slots render; when blank, no ads load.
VITE_ADSENSE_CLIENT=

# AdSense ad unit ids per placement (from your AdSense dashboard).
VITE_ADSENSE_SLOT_LEADERBOARD=
VITE_ADSENSE_SLOT_INCONTENT=
VITE_ADSENSE_SLOT_FOOTER=

# Privacy-friendly analytics domain (Plausible-style). Blank disables analytics.
VITE_ANALYTICS_DOMAIN=

# Tag outbound opportunity links as affiliate/sponsored (rel="sponsored nofollow").
VITE_AFFILIATE_ENABLED=false
