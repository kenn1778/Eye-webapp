# Gate the admin workspace. Set to "true" to enable /admin routes.
VITE_ENABLE_ADMIN=false

# Backend API base URL. Leave empty in development to use the Vite proxy.
# In production set this to the API origin, e.g. https://api.example.com
VITE_API_BASE_URL=

# Admin credentials are NOT stored in the client bundle any more.
# The server verifies credentials and issues an HttpOnly session cookie.
# See backend/.env.example to configure the admin account.
